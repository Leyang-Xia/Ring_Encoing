+#!/usr/bin/env bash
+# Run from a checkout at 4b6a4e83... after applying the integration patch.
+set -euo pipefail
+repo_root="$(cd "$(dirname "$0")/.." && pwd)"
+out="${1:-$repo_root/data/results/aligned-depth-cse}"
+mkdir -p "$out"
+out="$(cd "$out" && pwd)"
+mkdir -p "$out/baseline" "$out/integrated"
+cd "$repo_root"
+make -j3
+make test > "$out/root-tests.log" 2>&1
+cd xordepth
+make -j3
+make test > "$out/xordepth-tests.log" 2>&1
+for case_name in vandermonde rs cauchy gf8; do
+ case "$case_name" in
+  vandermonde) matrix=data/matrices/vandermonde_8to17_direct.txt; extra=(--also ../data/certificates/structured_ring_example.json);;
+  rs) matrix=data/matrices/systematic_rs_7_4_direct.txt; extra=(--also ../data/certificates/practical_mds_examples.json);;
+  cauchy) matrix=data/matrices/cauchy_7_4_direct.txt; extra=();;
+  gf8) matrix=data/matrices/gf8_10x10_expanded.txt; extra=();;
+ esac
+ ./build/xordepth frontier "$matrix" --share 2,3,0 "${extra[@]}" --output "$out/baseline/$case_name.json" > "$out/baseline/$case_name.stdout.json"
+ ./build/xordepth verify "$out/baseline/$case_name.json" > "$out/baseline/$case_name.verify.json"
+ ./build/xordepth frontier "$matrix" --share 2,3,0 "${extra[@]}" --include-ours --ours-restarts 1 --ours-seed 0 --output "$out/integrated/$case_name.json" > "$out/integrated/$case_name.stdout.json"
+ ./build/xordepth verify "$out/integrated/$case_name.json" > "$out/integrated/$case_name.verify.json"
+done
+./build/xordepth audit ../data/certificates/*.json --output "$out/baseline/audit.json" > "$out/baseline/audit.stdout.json"
+if [[ "${RUN_BOUNDED:-1}" == 1 ]]; then
+ ./build/xordepth bounded data/matrices/vandermonde_8to17_direct.txt --depth 6 --beam 64 --branch 16 --representations 8 --restarts 8 --seed 1 --timeout 180 --output "$out/baseline/bounded_vandermonde.json" > "$out/baseline/bounded_vandermonde.stdout.json" &
+ first=$!
+ ./build/xordepth bounded data/matrices/systematic_rs_7_4_direct.txt --depth 6 --beam 64 --branch 16 --representations 8 --restarts 8 --seed 1 --timeout 180 --output "$out/baseline/bounded_rs.json" > "$out/baseline/bounded_rs.stdout.json" &
+ second=$!
+ wait "$first"
+ wait "$second"
+ ./build/xordepth verify "$out/baseline/bounded_vandermonde.json" > "$out/baseline/bounded_vandermonde.verify.json"
+ ./build/xordepth verify "$out/baseline/bounded_rs.json" > "$out/baseline/bounded_rs.verify.json"
+fi
+cd "$repo_root"
+for case_name in vandermonde rs; do
+ if [[ "$case_name" == vandermonde ]]; then matrix=xordepth/data/matrices/vandermonde_8to17_direct.txt; else matrix=xordepth/data/matrices/systematic_rs_7_4_direct.txt; fi
+ ./build/ringlab analyze "$matrix" --method OUR_DCCSE --depth 6 --seeds 8 --seed 1 --output "$out/integrated/ours_${case_name}_d6_r8.json" > "$out/integrated/ours_${case_name}_d6_r8.stdout.json"
+ ./build/ringlab verify --input "$out/integrated/ours_${case_name}_d6_r8.json" --samples 0 > "$out/integrated/ours_${case_name}_d6_r8.verify.json"
+done
+if [[ "${RUN_PROFILE:-1}" == 1 ]]; then
+ ./build/ringlab profile systematic-rs-7-4 --path direct --method UBER_XSET --params 0 3 0 --timeout 60 --output "$out/baseline/readme_rs_profile.json" > "$out/baseline/readme_rs_profile.stdout.json"
+ ./build/ringlab verify --input "$out/baseline/readme_rs_profile.json" --samples 0 > "$out/baseline/readme_rs_profile.verify.json"
+fi
+printf 'Aligned native CLI experiments and verification complete: %s\n' "$out"
